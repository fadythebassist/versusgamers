---
import '../styles/skins.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../config/site';
import { DEFAULT_SKIN } from '../config/skins.mjs';
import skinsMeta from '../config/skins-meta.json';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in the other language (for hreflang and the language button). */
  altPath: string;
  /** Which main-nav item is current. */
  nav?: 'home' | 'originals' | 'favorites' | 'recent' | 'categories';
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}
const { lang, title, description, altPath, nav, ogImage = '/images/og-default.jpg', ogType = 'website', noindex = false } = Astro.props;
const s = t(lang);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const alternate = new URL(altPath, SITE.url).href;
const enUrl = lang === 'en' ? canonical : alternate;
const frUrl = lang === 'fr' ? canonical : alternate;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const skinIds = skinsMeta.map((m) => m.id);
const themeColors = Object.fromEntries(skinsMeta.map((m) => [m.id, m.bg]));
// Applies the saved skin before first paint (no flash) and loads only that skin's fonts.
const noFlash = `(function(){var ids=${JSON.stringify(skinIds)},tc=${JSON.stringify(themeColors)},s='${DEFAULT_SKIN}';try{var v=localStorage.getItem('vg.skin');if(v&&ids.indexOf(v)>-1)s=v;}catch(e){}var d=document.documentElement;d.setAttribute('data-skin',s);var l=document.createElement('link');l.rel='stylesheet';l.href='/fonts/'+s+'.css';l.id='skin-fonts';document.head.appendChild(l);var m=document.querySelector('meta[name=theme-color]');if(m)m.content=tc[s];})();`;
---
<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'} data-skin={DEFAULT_SKIN}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColors[DEFAULT_SKIN]} />
    <script is:inline set:html={noFlash}></script>
    <noscript><link rel="stylesheet" href={`/fonts/${DEFAULT_SKIN}.css`} /></noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.url}/`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_CA' : 'fr_CA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skipToContent}</a>
    <Header lang={lang} altPath={altPath} nav={nav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ConsentBanner lang={lang} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
