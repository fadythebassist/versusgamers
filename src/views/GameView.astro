---
import Base from '../layouts/Base.astro';
import PlayLabel from '../components/PlayLabel.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import RankList from '../components/RankList.astro';
import { related, catName, embedFor, popular, type Game } from '../lib/games';
import { path, t, other, type Lang } from '../i18n/ui';
import { SITE, PLAYGAMA } from '../config/site';

interface Props { lang: Lang; game: Game }
const { lang, game } = Astro.props;
const s = t(lang);
const txt = game[lang];
const cat = catName(lang, game.category);
const title = lang === 'fr' ? `${game.title} — Jouer en ligne | ${s.siteName}` : `${game.title} — Play online | ${s.siteName}`;
const more = related(game, 6);
const orientationLabel = game.orientation ? s.orientation[game.orientation] : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  url: `${SITE.url}${path.game(lang, game.slug)}`,
  description: txt.description,
  image: game.image,
  genre: cat,
  inLanguage: game.french ? ['en', 'fr'] : ['en'],
  gamePlatform: ['Web browser', 'Android', 'iOS'],
  applicationCategory: 'Game',
  operatingSystem: 'Any',
  playMode: 'SinglePlayer',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CAD', availability: 'https://schema.org/InStock' },
  publisher: { '@type': 'Organization', name: 'Playgama' },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.breadcrumbHome, item: `${SITE.url}${path.home(lang)}` },
    { '@type': 'ListItem', position: 2, name: cat, item: `${SITE.url}${path.category(lang, game.category)}` },
    { '@type': 'ListItem', position: 3, name: game.title },
  ],
};
const playerId = `player-${game.slug}`;
const picks = popular(8).filter((g) => g.slug !== game.slug && !more.includes(g)).slice(0, 5);
---
<Base lang={lang} title={title} description={txt.summary} altPath={path.game(other(lang), game.slug)} ogImage={game.image} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <div class="container">
    <nav class="crumbs" aria-label={lang === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'}>
      <a href={path.home(lang)}>{s.breadcrumbHome}</a><span aria-hidden="true">/</span>
      <a href={path.category(lang, game.category)}>{cat}</a><span aria-hidden="true">/</span>
      <span>{game.title}</span>
    </nav>
    <header class="game-head">
      <h1 class="game-title">{game.title}</h1>
      <div class="tags">
        <a class="tag accent" href={path.category(lang, game.category)}>{cat}</a>
        {game.french && <span class="tag">{s.playFrench}</span>}
        {orientationLabel && <span class="tag">{orientationLabel}</span>}
      </div>
    </header>

    <div class="with-rail" style="padding-top:0">
      <div class="main-col">
        <div>
          <div
            class={`player ${game.orientation === 'portrait' ? 'portrait' : game.orientation === 'landscape' ? 'landscape' : ''}`}
            id={playerId}
            data-player
            data-src={embedFor(game)}
            data-allow={PLAYGAMA.allow}
            data-title={game.title}
            data-consent="required"
            data-game-id={`g:${game.slug}`}
          >
            <div class="player-cover">
              <img src={game.image} alt="" width="448" height="280" />
              <button type="button" class="btn-play" data-play><PlayLabel lang={lang} label={s.play} /></button>
            </div>
            <div class="player-consent" hidden>
              <p>{s.consentNote}</p>
              <div class="row">
                <button type="button" class="btn-play" data-consent-play><span>{s.consentPlay}</span></button>
                <button type="button" class="btn-secondary" data-consent-cancel>{s.cancel}</button>
              </div>
              <a href={path.page(lang, 'privacy')} style="font-size:13px">{s.consentMore}</a>
            </div>
          </div>
          <div class="player-bar">
            <button type="button" class="icon-btn" data-fullscreen={playerId}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
              {s.fullscreen}
            </button>
            <button type="button" class="icon-btn fav-btn" data-fav-id={`g:${game.slug}`} aria-pressed="false" data-label-on={s.removeFavorite} data-label-off={s.addFavorite}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg>
              <span data-fav-label>{s.addFavorite}</span>
            </button>
          </div>
        </div>

        <AdSlot lang={lang} name="game-under-player" format="leader" />

        <section class="prose" aria-labelledby="about-game">
          <h2 class="h2" id="about-game">{s.aboutGame}</h2>
          <p>{txt.description}</p>
          <h2 class="h2" style="margin-top:20px">{s.howToPlay}</h2>
          <p>{txt.howToPlay}</p>
          <p class="note">{s.providedBy}</p>
        </section>

        <section aria-labelledby="related">
          <div class="sec-head">
            <h2 class="h2" id="related">{s.related}</h2>
            <a class="see-all" href={path.category(lang, game.category)}>{s.seeAll}</a>
          </div>
          <div class="grid">{more.map((g) => <GameCard game={g} lang={lang} />)}</div>
        </section>
      </div>
      <div class="rail">
        <AdSlot lang={lang} name="game-rail" format="rect" />
        <RankList games={picks} lang={lang} title={s.popularNow} />
      </div>
    </div>
  </div>
</Base>
