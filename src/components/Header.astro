---
import { t, path, other, type Lang } from '../i18n/ui';
import skinsMeta from '../config/skins-meta.json';
import { DEFAULT_SKIN } from '../config/skins.mjs';
interface Props { lang: Lang; altPath: string; nav?: string }
const { lang, altPath, nav } = Astro.props;
const s = t(lang);
const def = skinsMeta.find((m) => m.id === DEFAULT_SKIN)!;
const names = Object.fromEntries(skinsMeta.map((m) => [m.id, m.name[lang]]));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={path.home(lang)} aria-label={`${s.siteName} — ${s.nav.home}`}>
      <span class="logo-badge" aria-hidden="true"></span>
      <span class="logo-text" aria-hidden="true"><span class="w1">Versus</span><span class="sep"></span><span class="w2">Gamers</span></span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <a href={path.home(lang)} aria-current={nav === 'home' ? 'page' : undefined}>{s.nav.home}</a>
      <a href={path.page(lang, 'originals')} aria-current={nav === 'originals' ? 'page' : undefined}>{s.nav.originals}</a>
      <a href={path.page(lang, 'favorites')} aria-current={nav === 'favorites' ? 'page' : undefined}>{s.nav.favorites}</a>
      <a href={path.page(lang, 'recent')} aria-current={nav === 'recent' ? 'page' : undefined}>{s.nav.recent}</a>
    </nav>
    <div class="header-actions">
      <a class="search-btn" href={path.page(lang, 'search')} aria-label={s.searchGames}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <span class="label">{s.searchGames}</span>
      </a>
      <div class="skin-picker" data-skin-names={JSON.stringify(names)}>
        <button type="button" class="skin-btn" aria-haspopup="true" aria-expanded="false" aria-controls="skin-menu" aria-label={s.changeSkin}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.5-.8 1.5-1.6 0-.9-.6-1.4-.6-2.3 0-1 .8-1.6 1.8-1.6H17a4 4 0 0 0 4-4c0-4.7-4-8.5-9-8.5z"></path><circle cx="7.5" cy="11" r="1"></circle><circle cx="10.5" cy="7" r="1"></circle><circle cx="15" cy="7.5" r="1"></circle></svg>
          <span class="label">{s.skin}: <span data-skin-name>{def.name[lang]}</span></span>
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
        <div class="skin-menu" id="skin-menu" role="menu" aria-label={s.chooseSkin} hidden>
          <div class="menu-title" aria-hidden="true">{s.chooseSkin}</div>
          {skinsMeta.map((m) => (
            <button type="button" class="skin-option" role="menuitemradio" aria-checked={m.id === DEFAULT_SKIN ? 'true' : 'false'} data-skin-choice={m.id}>
              <span class="swatch" aria-hidden="true" style={`--sw-bg:${m.bg};--sw-a:${m.accent};--sw-b:${m.accent2}`}><span></span><span></span></span>
              {m.name[lang]}
            </button>
          ))}
        </div>
      </div>
      <a class="lang-btn" href={altPath} hreflang={other(lang)} lang={other(lang)} aria-label={s.switchLang} data-lang-switch>{s.langLabel}</a>
    </div>
  </div>
</header>
