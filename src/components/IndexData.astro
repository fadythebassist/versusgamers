---
import { clientIndex } from '../lib/games';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; keywords?: boolean }
const json = JSON.stringify(clientIndex(Astro.props.lang, Astro.props.keywords)).replace(/</g, '\\u003c');
---
<script type="application/json" id="games-index" set:html={json}></script>
