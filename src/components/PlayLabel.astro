---
// Play button content. The skin decides which label style shows (default, synthwave "press start", terminal "> play").
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; label?: string }
const { lang, label } = Astro.props;
const s = t(lang);
---
<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
<span class="pl-default">{label ?? s.playNow}</span>
<span class="pl-press">{s.pressStart}</span>
<span class="pl-term">{s.termPlay}</span>
